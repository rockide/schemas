{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Transformation Component",
	"description": "The block's translation, rotation and scale with respect to the center of its world position.",
	"additionalProperties": false,
	"properties": {
		"rotation": {
			"description": "The block's rotation in increments of 90 degrees.",
			"default": [0, 0, 0],
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "number",
						"multipleOf": 90
					},
					"minItems": 3,
					"maxItems": 3
				},
				{
					"$ref": "#/$defs/rotation_object"
				}
			]
		},
		"rotation_pivot": {
			"description": "The point to apply rotation around.",
			"default": [0, 0, 0],
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 3,
					"maxItems": 3
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"scale": {
			"description": "The block's scale.",
			"default": [1, 1, 1],
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 3,
					"maxItems": 3
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"scale_pivot": {
			"description": "The point to apply scale around.",
			"default": [0, 0, 0],
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 3,
					"maxItems": 3
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"translation": {
			"description": "The block's translation.",
			"default": [0, 0, 0],
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 3,
					"maxItems": 3
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		}
	},
	"$defs": {
		"vec3_object": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"x": {
					"type": "number",
					"default": 0
				},
				"y": {
					"type": "number",
					"default": 0
				},
				"z": {
					"type": "number",
					"default": 0
				}
			}
		},
		"rotation_object": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"x": {
					"type": "number",
					"default": 0,
					"multipleOf": 90
				},
				"y": {
					"type": "number",
					"default": 0,
					"multipleOf": 90
				},
				"z": {
					"type": "number",
					"default": 0,
					"multipleOf": 90
				}
			}
		}
	}
}
