{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"allOf": [
		{
			"if": {
				"required": ["description"],
				"properties": {
					"description": {
						"required": ["traits"],
						"properties": {
							"traits": {
								"required": ["minecraft:multi_block"]
							}
						}
					}
				}
			},
			"then": {
				"required": ["components"],
				"properties": {
					"components": {
						"$ref": "#/$defs/multi_block_components",
						"required": ["minecraft:movable"],
						"properties": {
							"minecraft:movable": {
								"properties": {
									"movement_type": {
										"enum": ["popped", "immovable"]
									}
								}
							}
						}
					},
					"permutations": {
						"items": {
							"properties": {
								"components": {
									"$ref": "#/$defs/multi_block_components",
									"allOf": [
										{
											"not": {
												"required": ["minecraft:movable"]
											}
										},
										{
											"not": {
												"required": ["minecraft:placement_filter"]
											}
										},
										{
											"not": {
												"required": ["minecraft:replaceable"]
											}
										},
										{
											"not": {
												"required": ["minecraft:random_offset"]
											}
										}
									]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"required": ["description"],
				"properties": {
					"description": {
						"required": ["traits"],
						"properties": {
							"traits": {
								"required": ["minecraft:multi_block"],
								"properties": {
									"minecraft:multi_block": {
										"required": ["direction"],
										"properties": {
											"direction": {
												"enum": ["north", "south", "east", "west"]
											}
										}
									}
								}
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"components": {
						"not": {
							"required": ["minecraft:random_offset"]
						}
					}
				}
			}
		}
	],
	"$defs": {
		"multi_block_components": {
			"properties": {
				"minecraft:geometry": {
					"not": {
						"type": "object",
						"required": ["n_way_visual_rotation"]
					}
				}
			}
		}
	}
}
