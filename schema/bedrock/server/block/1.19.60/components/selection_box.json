{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Selection Box Component",
	"description": "Defines the area of the block that is selected by the player's cursor.",
	"oneOf": [
		{
			"type": "boolean"
		},
		{
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"origin": {
					"$ref": "#/$defs/origin",
					"description": "Minimal position of the bounds of the selection box. Specified as [x, y, z] and must be in the range (-8, 0, -8) to (8, 16, 8), inclusive."
				},
				"size": {
					"$ref": "#/$defs/size",
					"description": "Size of each side of the selection box. Specified as [x, y, z]. origin + size must be in the range (-8, 0, -8) to (8, 16, 8), inclusive."
				}
			}
		}
	],
	"$defs": {
		"origin_xz": {
			"type": "number",
			"minimum": -8,
			"maximum": 8
		},
		"origin_y": {
			"type": "number",
			"minimum": 0,
			"maximum": 16
		},
		"size_xz": {
			"type": "number",
			"minimum": -16,
			"maximum": 16
		},
		"size_y": {
			"type": "number",
			"minimum": -16,
			"maximum": 16
		},
		"origin": {
			"oneOf": [
				{
					"type": "array",
					"minItems": 3,
					"maxItems": 3,
					"prefixItems": [
						{
							"$ref": "#/$defs/origin_xz"
						},
						{
							"$ref": "#/$defs/origin_y"
						},
						{
							"$ref": "#/$defs/origin_xz"
						}
					],
					"items": false
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"x": {
							"$ref": "#/$defs/origin_xz",
							"default": 0
						},
						"y": {
							"$ref": "#/$defs/origin_y",
							"default": 0
						},
						"z": {
							"$ref": "#/$defs/origin_xz",
							"default": 0
						}
					}
				}
			]
		},
		"size": {
			"oneOf": [
				{
					"type": "array",
					"minItems": 3,
					"maxItems": 3,
					"prefixItems": [
						{
							"$ref": "#/$defs/size_xz"
						},
						{
							"$ref": "#/$defs/size_y"
						},
						{
							"$ref": "#/$defs/size_xz"
						}
					],
					"items": false
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"x": {
							"$ref": "#/$defs/size_xz",
							"default": 0
						},
						"y": {
							"$ref": "#/$defs/size_y",
							"default": 0
						},
						"z": {
							"$ref": "#/$defs/size_xz",
							"default": 0
						}
					}
				}
			]
		}
	}
}
