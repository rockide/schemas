{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Transformation Component",
	"description": "The block's translation, rotation and scale with respect to the center of its world position.",
	"additionalProperties": false,
	"properties": {
		"rotation": {
			"description": "The block's rotation in increments of 90 degrees.",
			"anyOf": [
				{
					"$ref": "#/$defs/vec3_array"
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"rotation_pivot": {
			"description": "The point to apply rotation around.",
			"anyOf": [
				{
					"$ref": "#/$defs/vec3_array"
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"scale": {
			"description": "The block's scale.",
			"anyOf": [
				{
					"$ref": "#/$defs/vec3_array"
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"scale_pivot": {
			"description": "The point to apply scale around.",
			"anyOf": [
				{
					"$ref": "#/$defs/vec3_array"
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		},
		"translation": {
			"description": "The block's translation.",
			"anyOf": [
				{
					"$ref": "#/$defs/vec3_array"
				},
				{
					"$ref": "#/$defs/vec3_object"
				}
			]
		}
	},
	"$defs": {
		"vec3_array": {
			"type": "array",
			"items": {
				"type": "number"
			},
			"minItems": 3,
			"maxItems": 3
		},
		"vec3_object": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"x": {
					"type": "number",
					"default": 0
				},
				"y": {
					"type": "number",
					"default": 0
				},
				"z": {
					"type": "number",
					"default": 0
				}
			}
		}
	}
}
