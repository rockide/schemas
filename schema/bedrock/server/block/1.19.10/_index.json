{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Block 1.19.10",
	"description": "Block definition file for behavior packs (format_version 1.19.10)",
	"additionalProperties": false,
	"required": ["format_version", "minecraft:block"],
	"properties": {
		"format_version": {
			"type": "string"
		},
		"minecraft:block": {
			"type": "object",
			"title": "Block",
			"description": "Root block object",
			"additionalProperties": false,
			"required": ["description"],
			"properties": {
				"description": {
					"$ref": "../1.12.0/description.json"
				},
				"components": {
					"$ref": "./components/_index.json"
				}
			}
		}
	}
}
