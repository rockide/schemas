{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Recipe File",
	"description": "Schema for crafting and smelting recipe definition files used by behavior packs.",
	"required": ["format_version"],
	"properties": {
		"format_version": {
			"x-format-version": ["[1.0.0-1.20.10)", "[1.20.10-latest]"]
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.20.10-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.20.10/_index.json"
			},
			"else": {
				"$ref": "./1.0.0/_index.json"
			}
		}
	]
}
