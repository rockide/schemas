{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"item": {
			"oneOf": [
				{
					"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
					"minLength": 1
				},
				{
					"type": "object",
					"required": ["item"],
					"additionalProperties": false,
					"properties": {
						"item": {
							"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
							"minLength": 1
						},
						"data": {
							"type": "integer"
						}
					}
				}
			]
		},
		"item_count": {
			"oneOf": [
				{
					"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
					"minLength": 1
				},
				{
					"type": "object",
					"required": ["item"],
					"additionalProperties": false,
					"properties": {
						"item": {
							"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
							"minLength": 1
						},
						"count": {
							"type": "integer",
							"minimum": 1,
							"default": 1
						},
						"data": {
							"type": "integer"
						}
					}
				}
			]
		},
		"ingredient": {
			"oneOf": [
				{
					"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
					"minLength": 1
				},
				{
					"type": "object",
					"oneOf": [
						{
							"required": ["item"]
						},
						{
							"required": ["tag"]
						}
					],
					"additionalProperties": false,
					"properties": {
						"item": {
							"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
							"minLength": 1
						},
						"tag": {
							"$ref": "../../../vanilla/server/tags.json#/$defs/item_tag",
							"minLength": 1
						},
						"data": {
							"type": "integer"
						}
					}
				}
			]
		},
		"ingredient_count": {
			"oneOf": [
				{
					"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
					"minLength": 1
				},
				{
					"type": "object",
					"oneOf": [
						{
							"required": ["item"]
						},
						{
							"required": ["tag"]
						}
					],
					"additionalProperties": false,
					"properties": {
						"item": {
							"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
							"minLength": 1
						},
						"tag": {
							"$ref": "../../../vanilla/server/tags.json#/$defs/item_tag",
							"minLength": 1
						},
						"count": {
							"type": "integer",
							"minimum": 1,
							"default": 1
						},
						"data": {
							"type": "integer"
						}
					}
				}
			]
		},
		"station_tags": {
			"oneOf": [
				{
					"$ref": "../../../vanilla/server/tags.json#/$defs/recipe_tag",
					"minLength": 1
				},
				{
					"type": "array",
					"items": {
						"$ref": "../../../vanilla/server/tags.json#/$defs/recipe_tag",
						"minLength": 1
					}
				}
			]
		},
		"smithing_tags": {
			"oneOf": [
				{
					"const": "smithing_table"
				},
				{
					"type": "array",
					"minItems": 1,
					"maxItems": 1,
					"items": {
						"const": "smithing_table"
					}
				}
			]
		},
		"unlock_context": {
			"oneOf": [
				{
					"const": "None"
				},
				{
					"const": "AlwaysUnlocked",
					"description": "Always unlocks the item when the specified context is met."
				},
				{
					"const": "PlayerInWater",
					"description": "Unlocks the item the first time the player enters the water."
				},
				{
					"const": "PlayerHasManyItems",
					"description": "Player has more than 10 items in their inventory."
				}
			]
		},
		"unlock": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["context"],
					"properties": {
						"context": {
							"$ref": "#/$defs/unlock_context",
							"description": "The context in which the recipe is unlocked."
						}
					}
				},
				{
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/ingredient_count",
						"properties": {
							"item": {
								"$ref": "../../../vanilla/server/identifiers.json#/$defs/item_identifier",
								"description": "The item that must be obtained to unlock this recipe."
							},
							"tag": {
								"$ref": "../../../vanilla/server/tags.json#/$defs/item_tag",
								"description": "An item tag that matches multiple items that can be obtained to unlock this recipe."
							},
							"data": {
								"type": "integer",
								"description": "The item data/aux value for items with variants."
							}
						}
					}
				}
			]
		}
	}
}
