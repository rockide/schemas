{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Dimension File",
	"description": "Schema for custom dimension definition files used by behavior packs.",
	"required": ["format_version"],
	"x-format-version-enums": true,
	"properties": {
		"format_version": {
			"x-format-version": "[1.18.0-latest]"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.18.0-1.26.50)"
					}
				}
			},
			"then": {
				"$ref": "./1.18.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.26.50-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.26.50/_index.json"
			}
		}
	]
}
