{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Seed",
	"description": "Seed component for plantable items",
	"additionalProperties": false,
	"properties": {
		"crop_result": {
			"$ref": "../../../../../vanilla/server/identifiers.json#/$defs/block_identifier",
			"description": "Block identifier that grows from this seed"
		},
		"plant_at": {
			"description": "Block identifiers this seed can be planted on",
			"oneOf": [
				{
					"$ref": "../../../../../vanilla/server/identifiers.json#/$defs/block_identifier"
				},
				{
					"type": "array",
					"items": {
						"$ref": "../../../../../vanilla/server/identifiers.json#/$defs/block_identifier"
					}
				}
			]
		},
		"plant_at_any_solid_surface": {
			"type": "boolean"
		},
		"plant_at_face": {
			"type": "string",
			"enum": [
				"down",
				"up",
				"north",
				"south",
				"west",
				"east",
				"DOWN",
				"UP",
				"NORTH",
				"SOUTH",
				"WEST",
				"EAST"
			]
		}
	}
}
