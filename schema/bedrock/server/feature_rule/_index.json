{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Feature RUle File",
	"description": "Schema for feature rule definition files used by behavior packs.",
	"required": ["format_version"],
	"properties": {
		"format_version": {
			"x-format-version": "[1.12.0-latest]"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.12.0-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.12.0/_index.json"
			}
		}
	]
}
