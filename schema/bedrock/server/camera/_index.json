{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Camera Preset File",
	"description": "Schema for camera preset definition files used by behavior packs.",
	"required": ["format_version", "minecraft:camera_preset"],
	"properties": {
		"format_version": {
			"type": "string",
			"enum": ["1.19.50", "1.26.50"]
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"enum": ["1.19.50"]
					}
				}
			},
			"then": {
				"$ref": "./1.19.50/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"enum": ["1.26.50"]
					}
				}
			},
			"then": {
				"$ref": "./1.26.50/_index.json"
			}
		}
	]
}
