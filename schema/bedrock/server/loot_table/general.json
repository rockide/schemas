{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Loot Table General Types",
	"description": "Shared type definitions used across loot table components.",
	"$defs": {
		"integer_range": {
			"title": "Integer Range",
			"oneOf": [
				{
					"type": "integer"
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"description": "Min max",
					"items": {
						"type": "integer"
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"range_min": {
							"type": "integer"
						},
						"range_max": {
							"type": "integer"
						}
					}
				}
			]
		},
		"levels_range": {
			"type": "object",
			"title": "Levels Range",
			"description": "A range of enchantment levels.",
			"required": ["min", "max"],
			"additionalProperties": false,
			"properties": {
				"min": {
					"type": "number",
					"minimum": 0,
					"description": "Minimum enchantment level."
				},
				"max": {
					"type": "number",
					"minimum": 1,
					"description": "Maximum enchantment level."
				}
			}
		},
		"durability_range": {
			"$ref": "#/$defs/integer_range",
			"title": "Durability Range",
			"description": "A range of durability.",
			"properties": {
				"range_min": {
					"type": "integer",
					"description": "Minimum durability."
				},
				"range_max": {
					"type": "integer",
					"description": "Maximum durability."
				}
			}
		},
		"count_range": {
			"$ref": "#/$defs/integer_range",
			"title": "Count Range",
			"description": "A range of count values with minimum and maximum.",
			"minimum": 0,
			"items": {
				"minimum": 0
			},
			"properties": {
				"range_min": {
					"type": "integer",
					"minimum": 0,
					"description": "Minimum count."
				},
				"range_max": {
					"type": "integer",
					"minimum": 0,
					"description": "Maximum count."
				}
			}
		}
	}
}
