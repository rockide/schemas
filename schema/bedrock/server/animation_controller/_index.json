{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Animation Controller",
	"type": "object",
	"required": ["format_version", "animation_controllers"],
	"properties": {
		"format_version": {
			"anyOf": [
				{
					"$ref": "../../../vanilla/definition/format_version.json"
				},
				{
					"enum": ["1.8.0", "1.10.0", "1.17.30"]
				}
			],
			"$comment": "Controller format 1.8.0 or later. Versions below 1.10.0 use legacy parameter/remap arrays; 1.10.0 and later use scalar animation weights. Transition text is lowercased before 1.17.30 and case-preserved from 1.17.30. The engine also checks compatibility with its own game version."
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"type": "string",
						"pattern": "^1\\.0*[89](?:\\.[0-9]+)?(?![\\s\\S])"
					}
				}
			},
			"then": {
				"$ref": "./1.8.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"type": "string",
						"pattern": "^1\\.0*[1-9][0-9]+(?:\\.[0-9]+)?(?![\\s\\S])"
					}
				}
			},
			"then": {
				"$ref": "./1.10.0/_index.json"
			}
		}
	]
}
