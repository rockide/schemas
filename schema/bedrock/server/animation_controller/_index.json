{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Animation Controller",
	"type": "object",
	"required": ["format_version", "animation_controllers"],
	"x-format-version-enums": true,
	"properties": {
		"format_version": {
			"x-format-version": "[1.8.0-latest]"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.8.0-1.10.0)"
					}
				}
			},
			"then": {
				"$ref": "./1.8.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.10.0-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.10.0/_index.json"
			}
		}
	]
}
