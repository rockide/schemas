{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Trade Table File",
	"description": "Schema for trade table definition files used by behavior packs.",
	"properties": {
		"format_version": {
			"x-format-version": "[0.0.0-latest]"
		}
	},
	"allOf": [
		{
			"if": {
				"required": ["format_version"],
				"properties": {
					"format_version": {
						"x-format-version": "[1.21.30-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.21.30/_index.json"
			},
			"else": {
				"$ref": "./1.0.0/_index.json"
			}
		}
	]
}
