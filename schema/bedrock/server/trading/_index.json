{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Trade Table File",
	"description": "Schema for trade table definition files used by behavior packs.",
	"properties": {
		"format_version": {
			"type": "string",
			"pattern": "^(?:\\d+\\.\\d+(?:\\.\\d+)?|beta)$"
		}
	},
	"allOf": [
		{
			"if": {
				"required": ["format_version"],
				"properties": {
					"format_version": {
						"enum": [
							"1.21.30",
							"1.21.40",
							"1.21.50",
							"1.21.60",
							"1.21.70",
							"1.21.80",
							"1.21.90",
							"1.21.100",
							"1.21.110",
							"1.21.120",
							"1.21.130",
							"1.26.0",
							"1.26.10",
							"1.26.20",
							"1.26.30",
							"1.26.40",
							"1.26.50",
							"1.26.60"
						]
					}
				}
			},
			"then": {
				"$ref": "./1.21.30/_index.json"
			},
			"else": {
				"$comment": "[0.0.0, 1.21.30)",
				"$ref": "./1.0.0/_index.json"
			}
		}
	]
}
