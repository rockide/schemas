						"type": "object",
						"additionalProperties": false,
						"required": ["collection", "steps"],
						"properties": {
							"collection": {
								"$ref": "../../../../vanilla/definition/identifier.json#/$defs/no_minecraft"
							},
							"steps": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		}
	}
}
