{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Shifts 1.26.20",
	"additionalProperties": false,
	"required": ["format_version", "minecraft:shifts"],
	"properties": {
		"format_version": {
			"type": "string"
		},
		"minecraft:shifts": {
			"type": "object",
