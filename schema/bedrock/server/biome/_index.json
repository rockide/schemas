{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Biome Definition",
	"description": "Schema for custom biome definition files used by behavior packs.",
	"required": ["format_version"],
	"x-format-version-enums": true,
	"properties": {
		"format_version": {
			"x-format-version": "[1.21.110-latest]"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.21.110-1.26.0)"
					}
				}
			},
			"then": {
				"$ref": "./1.21.110/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.26.0-1.26.30)"
					}
				}
			},
			"then": {
				"$ref": "./1.26.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.26.30-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.26.30/_index.json"
			}
		}
	]
}
