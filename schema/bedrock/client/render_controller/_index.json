{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["format_version", "render_controllers"],
	"properties": {
		"format_version": {
			"anyOf": [
				{
					"$ref": "../../../vanilla/definition/format_version.json"
				},
				{
					"enum": ["1.8.0"]
				}
			]
		},
		"render_controllers": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": {
				"pattern": "^controller\\.render\\.[a-zA-Z0-9_.:-]+$"
			},
			"additionalProperties": {
				"$ref": "#/$defs/render_controller"
			}
		}
	},
	"$defs": {
		"render_controller": {
			"type": "object",
			"additionalProperties": false,
			"required": ["geometry", "textures"],
			"properties": {
				"arrays": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"geometries": {
							"type": "object",
							"minProperties": 1,
							"propertyNames": {
								"pattern": "^[aA]rray\\.[a-zA-Z0-9_.:-]+$"
							},
							"additionalProperties": {
								"type": "array",
								"minItems": 1,
								"items": {
									"$ref": "#/$defs/geometry_ref"
								}
							}
						},
						"materials": {
							"type": "object",
							"minProperties": 1,
							"propertyNames": {
								"pattern": "^[aA]rray\\.[a-zA-Z0-9_.:-]+$"
							},
							"additionalProperties": {
								"type": "array",
								"minItems": 1,
								"items": {
									"$ref": "#/$defs/material_ref"
								}
							}
						},
						"textures": {
							"type": "object",
							"minProperties": 1,
							"propertyNames": {
								"pattern": "^[aA]rray\\.[a-zA-Z0-9_.:-]+$"
							},
							"additionalProperties": {
								"type": "array",
								"minItems": 1,
								"items": {
									"$ref": "#/$defs/texture_ref"
								}
							}
						}
					}
				},
				"color": {
					"$ref": "#/$defs/color"
				},
				"filter_lighting": {
					"type": "boolean",
					"const": true
				},
				"geometry": {
					"$ref": "#/$defs/geometry_ref"
				},
				"ignore_lighting": {
					"type": "boolean",
					"default": false
				},
				"is_hurt_color": {
					"$ref": "#/$defs/color"
				},
				"light_color_multiplier": {
					"$ref": "../../../vanilla/definition/molang.json#/$defs/condition",
					"default": 1
				},
				"materials": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"minProperties": 1,
						"additionalProperties": false,
						"patternProperties": {
							"^[a-zA-Z0-9_.:*]+$": {
								"$ref": "#/$defs/material_ref"
							}
						}
					}
				},
				"on_fire_color": {
					"$ref": "#/$defs/color"
				},
				"overlay_color": {
					"$ref": "#/$defs/color"
				},
				"part_visibility": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"minProperties": 1,
						"propertyNames": {
							"pattern": "^[a-zA-Z0-9_.:*]+$"
						},
						"additionalProperties": {
							"$ref": "../../../vanilla/definition/molang.json#/$defs/condition"
						}
					}
				},
				"rebuild_animation_matrices": {
					"type": "boolean",
					"default": false
				},
				"textures": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/texture_ref"
					}
				},
				"uv_anim": {
					"$ref": "#/$defs/uv_anim",
					"default": {
						"offset": [0, 0],
						"scale": [1, 1]
					}
				}
			}
		},
		"color": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"r": {
					"$ref": "../../../vanilla/definition/molang.json#/$defs/condition",
					"default": "this"
				},
				"g": {
					"$ref": "../../../vanilla/definition/molang.json#/$defs/condition",
					"default": "this"
				},
				"b": {
					"$ref": "../../../vanilla/definition/molang.json#/$defs/condition",
					"default": "this"
				},
				"a": {
					"$ref": "../../../vanilla/definition/molang.json#/$defs/condition",
					"default": "this"
				}
			}
		},
		"uv_anim": {
			"type": "object",
			"additionalProperties": false,
			"required": ["offset", "scale"],
			"properties": {
				"offset": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": {
						"$ref": "../../../vanilla/definition/molang.json#/$defs/condition"
					}
				},
				"scale": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": {
						"$ref": "../../../vanilla/definition/molang.json#/$defs/condition"
					}
				}
			}
		},
		"geometry_ref": {
			"$ref": "../../../vanilla/definition/molang.json#/$defs/string",
			"examples": ["Geometry.default"]
		},
		"texture_ref": {
			"$ref": "../../../vanilla/definition/molang.json#/$defs/string",
			"examples": ["Texture.default"]
		},
		"material_ref": {
			"$ref": "../../../vanilla/definition/molang.json#/$defs/string",
			"examples": ["Material.default"]
		}
	}
}
