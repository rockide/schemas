{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"resource_pack_name": {
			"type": "string",
			"examples": ["pack.name"]
		},
		"texture_name": {
			"type": "string",
			"const": "atlas.terrain"
		},
		"padding": {
			"type": "integer",
			"default": 0
		},
		"num_mip_levels": {
			"type": "integer",
			"default": 1
		},
		"texture_data": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": ["textures"],
				"properties": {
					"additive": {
						"type": "boolean",
						"description": "Layers all of textures on top of each other.",
						"default": false
					},
					"quad": {
						"$ref": "#/$defs/quad",
						"default": false
					},
					"textures": {
						"oneOf": [
							{ "$ref": "#/$defs/texture_entry" },
							{
								"type": "array",
								"items": { "$ref": "#/$defs/texture_entry" }
							}
						]
					},
					"mip_fade_amount": {
						"type": "number",
						"default": 0
					},
					"mip_fade_color": {
						"$ref": "#/$defs/color",
						"default": [0, 0, 0, 0]
					}
				}
			}
		},
		"default_leather_color": {
			"$ref": "#/$defs/optional_hex_color"
		},
		"default_horse_leather_color": {
			"$ref": "#/$defs/optional_hex_color"
		}
	},
	"$defs": {
		"hex_color": {
			"type": "string",
			"description": "Hex string (#RRGGBB)",
			"pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
		},
		"optional_hex_color": {
			"anyOf": [{ "const": "" }, { "$ref": "#/$defs/hex_color" }]
		},
		"color": {
			"oneOf": [
				{
					"type": "array",
					"description": "RGB or RGBA array [0..255].",
					"minItems": 3,
					"items": {
						"type": "integer",
						"minimum": 0,
						"maximum": 255
					}
				},
				{
					"$ref": "#/$defs/hex_color"
				}
			]
		},
		"quad": {
			"description": "If set to true, only the first quadrant of the texture will be used.",
			"oneOf": [
				{
					"type": "boolean"
				},
				{
					"type": "number"
				}
			]
		},
		"texture_entry": {
			"oneOf": [{ "$ref": "#/$defs/texture_path" }, { "$ref": "#/$defs/texture_entry_object" }]
		},
		"texture_path": {
			"anyOf": [
				{ "type": "string" },
				{ "$ref": "../../../vanilla/client/paths.json#/$defs/texture_path" }
			]
		},
		"texture_variant": {
			"oneOf": [
				{ "$ref": "#/$defs/texture_path" },
				{
					"$ref": "#/$defs/texture_entry_object",
					"not": { "required": ["variations"] }
				}
			]
		},
		"color_matrix": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"r_color": { "$ref": "#/$defs/color" },
				"g_color": { "$ref": "#/$defs/color" },
				"b_color": { "$ref": "#/$defs/color" },
				"a_color": { "$ref": "#/$defs/color" }
			}
		},
		"isotropic": {
			"oneOf": [
				{ "type": "boolean" },
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"up": { "type": "boolean" },
						"down": { "type": "boolean" },
						"side": { "type": "boolean" },
						"north": { "type": "boolean" },
						"south": { "type": "boolean" },
						"west": { "type": "boolean" },
						"east": { "type": "boolean" }
					},
					"if": { "required": ["side"] },
					"then": {
						"properties": {
							"north": false,
							"south": false,
							"west": false,
							"east": false
						}
					}
				}
			]
		},
		"texture_entry_object": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"path": {
					"$ref": "#/$defs/texture_path",
					"default": ""
				},
				"overlay_color": {
					"$ref": "#/$defs/optional_hex_color"
				},
				"tint_color": {
					"oneOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/color_matrix" }],
					"default": [255, 255, 255, 255]
				},
				"tint_map_path": {
					"$ref": "#/$defs/texture_path",
					"default": ""
				},
				"tint_base_color": {
					"$ref": "#/$defs/color_matrix"
				},
				"mip_fade_color": {
					"$ref": "#/$defs/color"
				},
				"mip_fade_amount": {
					"type": "number"
				},
				"weight": {
					"type": "number",
					"default": 1
				},
				"isotropic": {
					"$ref": "#/$defs/isotropic",
					"default": false
				},
				"variations": {
					"type": "array",
					"items": { "$ref": "#/$defs/texture_variant" }
				}
			}
		}
	}
}
