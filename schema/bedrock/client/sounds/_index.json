{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Minecraft Bedrock Sounds",
	"description": "The sounds.json file defines sound events, entity sounds, block sounds, and interactive sounds for a resource pack.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"block_sounds": {
			"$ref": "#/$defs/block_sounds"
		},
		"entity_sounds": {
			"$ref": "#/$defs/entity_sounds"
		},
		"individual_event_sounds": {
			"$ref": "#/$defs/individual_event_sounds"
		},
		"individual_named_sounds": {
			"$ref": "#/$defs/individual_named_sounds"
		},
		"interactive_sounds": {
			"$ref": "#/$defs/interactive_sounds"
		}
	},
	"$defs": {
		"float_range": {
			"oneOf": [
				{
					"type": "number"
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "number" }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"min": { "type": "number" },
						"max": { "type": "number" }
					}
				},
				{
					"type": "string"
				}
			]
		},
		"event_name": {
			"$ref": "../../../vanilla/server/level_sound.json",
			"not": {
				"const": "undefined"
			}
		},
		"sound_event": {
			"description": "Defines a sound for a specific event.",
			"oneOf": [
				{
					"type": "string",
					"description": "The sound identifier to play for this event.",
					"$ref": "../../../vanilla/client/identifiers.json#/$defs/sound_identifier"
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"sound": {
							"description": "The sound identifier to play for this event.",
							"$ref": "../../../vanilla/client/identifiers.json#/$defs/sound_identifier"
						},
						"pitch": {
							"description": "Pitch multiplier for this sound.",
							"$ref": "#/$defs/float_range"
						},
						"volume": {
							"description": "Volume multiplier for this sound.",
							"$ref": "#/$defs/float_range"
						}
					}
				}
			]
		},
		"sound_events": {
			"type": "object",
			"propertyNames": {
				"$ref": "#/$defs/event_name"
			},
			"additionalProperties": {
				"$ref": "#/$defs/sound_event"
			}
		},
		"sound_variants": {
			"type": "object",
			"additionalProperties": false,
			"required": ["key", "map"],
			"properties": {
				"key": {
					"$ref": "../../../vanilla/definition/molang.json#/$defs/string"
				},
				"map": {
					"type": "object",
					"minProperties": 1
				}
			}
		},
		"entity_sound_definition": {
			"type": "object",
			"required": ["events"],
			"properties": {
				"events": {
					"$ref": "#/$defs/sound_events"
				},
				"pitch": {
					"description": "Default pitch for this sound group.",
					"$ref": "#/$defs/float_range"
				},
				"volume": {
					"description": "Default volume for this sound group.",
					"$ref": "#/$defs/float_range"
				}
			}
		},
		"block_sounds": {
			"type": "object",
			"description": "Defines sounds that play when interacting with blocks (breaking, placing, stepping).",
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"base": {
						"description": "Parent sound category to inherit sound settings from.",
						"$ref": "../../../vanilla/client/identifiers.json#/$defs/block_sound_identifier"
					},
					"events": {
						"$ref": "#/$defs/sound_events"
					},
					"pitch": {
						"description": "Pitch multiplier for block sounds.",
						"$ref": "#/$defs/float_range"
					},
					"volume": {
						"description": "Volume multiplier for block sounds.",
						"$ref": "#/$defs/float_range"
					}
				},
				"if": {
					"required": ["base"],
					"properties": {
						"base": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"else": {
					"required": ["events"]
				}
			}
		},
		"entity_sounds": {
			"type": "object",
			"description": "Defines sounds for entities, including defaults and entity-specific overrides.",
			"additionalProperties": false,
			"properties": {
				"defaults": {
					"description": "Default sound settings that apply to all entities unless overridden.",
					"$ref": "#/$defs/entity_sound_definition"
				},
				"entities": {
					"type": "object",
					"description": "Entity-specific sound configurations that override defaults.",
					"additionalProperties": {
						"description": "Sound configuration for a specific entity type.",
						"unevaluatedProperties": false,
						"allOf": [
							{
								"type": "object",
								"properties": {
									"__molang_version": {
										"type": "number"
									},
									"variants": {
										"$ref": "#/$defs/sound_variants",
										"properties": {
											"map": {
												"additionalProperties": {
													"$ref": "#/$defs/entity_sound_definition",
													"unevaluatedProperties": false
												}
											}
										}
									}
								}
							},
							{
								"$ref": "#/$defs/entity_sound_definition"
							}
						]
					}
				}
			}
		},
		"individual_event_sounds": {
			"description": "Defines individual sound events that can be triggered by various game actions.",
			"$ref": "#/$defs/entity_sound_definition",
			"unevaluatedProperties": false
		},
		"individual_named_sounds": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sounds"],
			"properties": {
				"sounds": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/sound_event"
					}
				},
				"pitch": {
					"$ref": "#/$defs/float_range"
				},
				"volume": {
					"$ref": "#/$defs/float_range"
				}
			}
		},
		"interactive_sound_definition": {
			"type": "object",
			"properties": {
				"events": {
					"type": "object",
					"propertyNames": {
						"$ref": "#/$defs/event_name"
					},
					"additionalProperties": {
						"type": "object",
						"propertyNames": { "minLength": 1 },
						"additionalProperties": {
							"$ref": "#/$defs/sound_event"
						}
					}
				},
				"pitch": {
					"$ref": "#/$defs/float_range"
				},
				"volume": {
					"$ref": "#/$defs/float_range"
				}
			}
		},
		"interactive_sounds": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"block_sounds": {
					"$ref": "#/$defs/block_sounds"
				},
				"entity_sounds": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"defaults": {
							"$ref": "#/$defs/interactive_sound_definition",
							"unevaluatedProperties": false
						},
						"entities": {
							"type": "object",
							"additionalProperties": {
								"unevaluatedProperties": false,
								"allOf": [
									{
										"type": "object",
										"properties": {
											"__molang_version": {
												"type": "number"
											},
											"variants": {
												"$ref": "#/$defs/sound_variants",
												"properties": {
													"map": {
														"additionalProperties": {
															"$ref": "#/$defs/interactive_sound_definition",
															"unevaluatedProperties": false
														}
													}
												}
											}
										}
									},
									{
										"$ref": "#/$defs/interactive_sound_definition"
									}
								]
							}
						}
					}
				}
			}
		}
	}
}
