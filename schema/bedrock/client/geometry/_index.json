{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "Minecraft Bedrock Geometry File",
	"description": "Schema for geometry model files used by the Minecraft resource pack.",
	"required": ["format_version"],
	"x-format-version-enums": true,
	"properties": {
		"format_version": {
			"x-format-version": "[1.8.0-latest]"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.8.0-1.12.0)"
					}
				}
			},
			"then": {
				"$ref": "./1.8.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.12.0-1.14.0)"
					}
				}
			},
			"then": {
				"$ref": "./1.12.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.14.0-1.16.0)"
					}
				}
			},
			"then": {
				"$ref": "./1.14.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.16.0-1.19.30)"
					}
				}
			},
			"then": {
				"$ref": "./1.16.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.19.30-1.21.0)"
					}
				}
			},
			"then": {
				"$ref": "./1.19.30/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.21.0-1.26.40)"
					}
				}
			},
			"then": {
				"$ref": "./1.21.0/_index.json"
			}
		},
		{
			"if": {
				"properties": {
					"format_version": {
						"x-format-version": "[1.26.40-latest]"
					}
				}
			},
			"then": {
				"$ref": "./1.26.40/_index.json"
			}
		}
	]
}
