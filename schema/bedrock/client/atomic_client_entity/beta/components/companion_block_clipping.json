{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"title": "minecraft:companion_block_clipping",
	"description": "Defines companion block clipping behavior, transition effects, and hysteresis controls.",
	"additionalProperties": false,
	"properties": {
		"hide_boundary": {
			"$ref": "#/$defs/visibility_boundary",
			"default": {
				"lookahead_max": 1,
				"lookahead_per_speed": 0.1,
				"margin": 0.5
			}
		},
		"hide_delay_seconds": {
			"type": "number",
			"minimum": 0,
			"default": 0
		},
		"hide_transition_seconds": {
			"type": "number",
			"minimum": 0,
			"default": 0.25
		},
		"min_hidden_seconds": {
			"type": "number",
			"minimum": 0,
			"default": 2
		},
		"min_visible_seconds": {
			"type": "number",
			"minimum": 0,
			"default": 0
		},
		"reveal_boundary": {
			"$ref": "#/$defs/visibility_boundary",
			"default": {
				"lookahead_max": 1,
				"lookahead_per_speed": 0.1,
				"margin": 0.5
			}
		}
	},
	"$defs": {
		"visibility_boundary": {
			"type": "object",
			"title": "minecraft:companion_visibility_boundary",
			"additionalProperties": false,
			"properties": {
				"lookahead_max": {
					"type": "number",
					"minimum": 0,
					"default": 1
				},
				"lookahead_per_speed": {
					"type": "number",
					"minimum": 0,
					"default": 0.1
				},
				"margin": {
					"type": "number",
					"minimum": 0,
					"default": 0.5
				}
			}
		}
	}
}
