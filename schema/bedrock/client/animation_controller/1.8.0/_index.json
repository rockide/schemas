{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Animation Controller",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"format_version": {
			"type": "string",
			"const": "1.8.0"
		},
		"animation_controllers": {
			"type": "object",
			"propertyNames": {
				"pattern": "^controller\\.animation\\.[a-zA-Z0-9_.-]+$"
			},
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"initial_state": {
						"type": "string"
					},
					"states": {
						"type": "object",
						"propertyNames": {
							"pattern": "^[a-zA-Z0-9_.-]+$"
						},
						"additionalProperties": {
							"$ref": "#/$defs/state"
						}
					}
				}
			}
		}
	},
	"$defs": {
		"state": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"animations": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/animation"
					}
				},
				"on_entry": {
					"type": "array",
					"items": {
						"$ref": "../../../../vanilla/definition/molang.json#/$defs/string"
					}
				},
				"on_exit": {
					"type": "array",
					"items": {
						"$ref": "../../../../vanilla/definition/molang.json#/$defs/string"
					}
				},
				"parameters": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"particle_effects": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/particle_effect"
					}
				},
				"transitions": {
					"type": "array",
					"items": {
						"type": "object",
						"minProperties": 1,
						"maxProperties": 1,
						"propertyNames": {
							"pattern": "^[a-zA-Z0-9_.-]+$"
						},
						"additionalProperties": {
							"$ref": "../../../../vanilla/definition/molang.json#/$defs/condition"
						}
					}
				}
			}
		},
		"animation": {
			"type": "object",
			"minProperties": 1,
			"maxProperties": 1,
			"propertyNames": {
				"pattern": "^[a-zA-Z0-9_.-]+$"
			},
			"additionalProperties": {
				"type": "array",
				"items": {
					"type": "object",
					"propertyNames": {
						"pattern": "^[0-9]+(\\.[0-9]+)?$"
					},
					"additionalProperties": {
						"type": "number"
					}
				}
			}
		},
		"particle_effect": {
			"type": "object",
			"additionalProperties": false,
			"required": ["effect"],
			"properties": {
				"effect": {
					"type": "string",
					"description": "The name of a particle effect that should be played."
				},
				"locator": {
					"type": "string",
					"description": "The name of a locator on the actor where the effect should be located."
				},
				"pre_effect_script": {
					"type": "string",
					"description": "A Molang script that will be run when the particle emitter is initialized."
				},
				"bind_to_actor": {
					"type": "boolean",
					"description": "Set to false to have the effect spawned in the world without being bound to an actor (by default an effect is bound to the actor).",
					"const": false
				}
			}
		}
	}
}
