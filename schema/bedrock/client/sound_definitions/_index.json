{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Minecraft Bedrock Sound Definitions",
	"type": "object",
	"properties": {
		"format_version": {
			"type": "string",
			"description": "Sound definitions format version.",
			"enum": ["1.13.0", "1.14.0", "1.20.20", "1.26.50"]
		},
		"sound_definitions": {
			"type": "object",
			"description": "Sound event definitions keyed by event identifier."
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": { "const": "1.13.0" }
				}
			},
			"then": { "$ref": "./1.13.0/_index.json" }
		},
		{
			"if": {
				"properties": {
					"format_version": { "const": "1.14.0" }
				}
			},
			"then": { "$ref": "./1.14.0/_index.json" }
		},
		{
			"if": {
				"properties": {
					"format_version": { "const": "1.20.20" }
				}
			},
			"then": { "$ref": "./1.20.20/_index.json" }
		},
		{
			"if": {
				"properties": {
					"format_version": { "const": "1.26.50" }
				}
			},
			"then": { "$ref": "./1.26.50/_index.json" }
		}
	]
}
