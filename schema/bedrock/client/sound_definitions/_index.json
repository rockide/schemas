{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Minecraft Bedrock Sound Definitions",
	"type": "object",
	"x-format-version-enums": true,
	"properties": {
		"format_version": {
			"description": "Sound definitions format version.",
			"x-format-version": "[1.13.0-latest]"
		},
		"sound_definitions": {
			"type": "object",
			"description": "Sound event definitions keyed by event identifier."
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"format_version": { "x-format-version": "[1.13.0-1.14.0)" }
				}
			},
			"then": { "$ref": "./1.13.0/_index.json" }
		},
		{
			"if": {
				"properties": {
					"format_version": { "x-format-version": "[1.14.0-1.20.20)" }
				}
			},
			"then": { "$ref": "./1.14.0/_index.json" }
		},
		{
			"if": {
				"properties": {
					"format_version": { "x-format-version": "[1.20.20-1.26.50)" }
				}
			},
			"then": { "$ref": "./1.20.20/_index.json" }
		},
		{
			"if": {
				"properties": {
					"format_version": { "x-format-version": "[1.26.50-latest]" }
				}
			},
			"then": { "$ref": "./1.26.50/_index.json" }
		}
	]
}
