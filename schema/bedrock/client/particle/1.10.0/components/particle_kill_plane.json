{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "minecraft:particle_kill_plane",
	"description": "Expires particles when crossing a plane. A*x + B*y + C*z + D = 0 with the parameters being [ A, B, C, D ]",
	"oneOf": [
		{
			"type": "array",
			"items": {
				"type": "number"
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"x": {
					"type": "number"
				},
				"y": {
					"type": "number"
				},
				"z": {
					"type": "number"
				},
				"w": {
					"type": "number"
				}
			}
		}
	]
}
