{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"linear": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "input", "nodes"],
			"properties": {
				"type": {
					"const": "linear"
				},
				"horizontal_range": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression",
					"default": 1
				},
				"input": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
				},
				"nodes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 100,
					"items": {
						"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
					}
				}
			}
		},
		"bezier": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "input", "nodes"],
			"properties": {
				"type": {
					"const": "bezier"
				},
				"horizontal_range": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression",
					"default": 1
				},
				"input": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
				},
				"nodes": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": {
						"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
					}
				}
			}
		},
		"catmull_rom": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "input", "nodes"],
			"properties": {
				"type": {
					"const": "catmull_rom"
				},
				"horizontal_range": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression",
					"default": 1
				},
				"input": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
				},
				"nodes": {
					"type": "array",
					"minItems": 4,
					"maxItems": 100,
					"items": {
						"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
					}
				}
			}
		},
		"bezier_chain": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "input", "nodes"],
			"properties": {
				"type": {
					"const": "bezier_chain"
				},
				"input": {
					"$ref": "../../../../vanilla/definition/molang.json#/$defs/expression"
				},
				"nodes": {
					"type": "object",
					"additionalProperties": false,
					"patternProperties": {
						"^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$": {
							"type": "object",
							"additionalProperties": false,
							"allOf": [
								{
									"anyOf": [
										{
											"required": ["value"]
										},
										{
											"required": ["left_value", "right_value"]
										}
									]
								},
								{
									"anyOf": [
										{
											"required": ["slope"]
										},
										{
											"required": ["left_slope", "right_slope"]
										}
									]
								}
							],
							"properties": {
								"left_slope": {
									"type": "number"
								},
								"left_value": {
									"type": "number"
								},
								"right_slope": {
									"type": "number"
								},
								"right_value": {
									"type": "number"
								},
								"slope": {
									"type": "number"
								},
								"value": {
									"type": "number"
								}
							}
						}
					}
				}
			}
		}
	}
}
