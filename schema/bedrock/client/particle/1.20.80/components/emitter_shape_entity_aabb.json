{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "minecraft:emitter_shape_entity_aabb",
	"description": "Emits particles from the entity AABB or emitter point.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"surface_only": {
			"description": "Emit only from the surface.",
			"type": "boolean",
			"default": false
		},
		"direction": {
			"description": "Particle emission direction.",
			"default": "outwards",
			"oneOf": [
				{
					"anyOf": [
						{
							"enum": ["inwards", "outwards"]
						},
						{
							"type": "string",
							"pattern": "^(?:[iI][nN][wW][aA][rR][dD][sS]|[oO][uU][tT][wW][aA][rR][dD][sS])$"
						}
					]
				},
				{
					"type": "array",
					"minItems": 3,
					"maxItems": 3,
					"items": {
						"$ref": "../../../../../vanilla/definition/molang.json#/$defs/expression"
					}
				}
			]
		}
	}
}
